# =============================================================================
# Career Navigator Backend Environment Configuration (Example Template)
# =============================================================================
# Copy this file to .env and insert your real credentials.
# Do not commit real keys to version control.

# Google Gemini API Key (Required for live AI Career Assistant responses)
# Generate a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_REAL_GEMINI_API_KEY_HERE

# Supported Gemini Model (Default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=YOUR_SUPPORTED_GEMINI_MODEL

# Backend Server Port
PORT=8081

# Frontend Application URL
APP_URL=http://localhost:3000

# Session Secret (Change in production)
SESSION_SECRET=career-navigator-default-dev-secret-key-change-in-prod
