# =============================================================================
# Career Navigator Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# Required: AI Service
# -----------------------------------------------------------------------------
# Gemini API key for AI-powered features (resume analysis, interview generation)
GEMINI_API_KEY="your_gemini_api_key_here"

# MiMo TTS API key for voice features (optional)
MIMO_API_KEY="your_mimo_api_key_here"

# -----------------------------------------------------------------------------
# Required: Application URL
# -----------------------------------------------------------------------------
# The public URL where the application is hosted
# Used for OAuth callbacks, API endpoints, and self-referential links
# Example: https://careernavigator.yourdomain.com
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Required: Google OAuth (for authentication)
# -----------------------------------------------------------------------------
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional: Server Configuration
# -----------------------------------------------------------------------------
# Port for the Express server (default: 3000)
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Optional: Frontend API Base URL (defaults to empty for same-origin and Vite dev proxy)
# VITE_API_BASE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optional: Session Configuration
# -----------------------------------------------------------------------------
# Session secret for cookie signing (recommended for production)
SESSION_SECRET="change_this_to_a_secure_random_string"

# -----------------------------------------------------------------------------
# Optional: Email Service (for Live Password Reset Delivery)
# -----------------------------------------------------------------------------
# Required if sending real password reset emails via SMTP or Resend
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Career Navigator <noreply@careernavigator.app>"
RESEND_API_KEY=""

# -----------------------------------------------------------------------------
# Optional: SMS Gateway (for Mobile OTP Authentication)
# -----------------------------------------------------------------------------
# Required for live SMS OTP delivery. If absent, dev preview provides local codes
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+15551234567"
